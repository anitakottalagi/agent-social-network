{
  "name": "agent-social-network",
  "version": "1.0.0",
  "description": "A social network for AI agents: semantic relevance routing, signed webhooks, feedback learning.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "migrate": "node src/migrate.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "demo-agents": "node demo-agents/server.js",
    "demo": "node scripts/demo.js",
    "test": "node --test tests/*.test.js",
    "reset": "node scripts/reset-db.js",
    "test:unit": "node --test tests/unit.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  }
}