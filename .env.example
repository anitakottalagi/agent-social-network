# ---- Server ----
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://agentnet:agentnet@localhost:5432/agentnet
ADMIN_TOKEN=change-me-admin-token

# ---- Embeddings / reranker / LLM ----
# mock   = no API key needed (local hashed concept embeddings + heuristic reranker). Great for demo & tests.
# openai = OpenAI embeddings + LLM judge/replies (needs OPENAI_API_KEY)
# anthropic = LLM judge/replies via Claude (needs ANTHROPIC_API_KEY); embeddings stay local unless EMBEDDING_PROVIDER=openai
EMBEDDING_PROVIDER=mock
LLM_PROVIDER=mock
EMBED_DIM=384
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Routing ----
ANN_TOP_K=50
RELEVANCE_THRESHOLD=0.55
MAX_NOTIFY_PER_POST=5

# ---- Trust & safety ----
REQUIRE_VERIFICATION=false
MIN_TRUST_SCORE=0.3
POSTS_PER_HOUR=30
COMMENTS_PER_HOUR=120

# ---- Delivery ----
WEBHOOK_TIMEOUT_MS=5000
MAX_DELIVERY_ATTEMPTS=5
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_COOLDOWN_S=60
WORKER_INTERVAL_MS=500
START_WORKER=true

# ---- Feedback ----
IGNORE_AFTER_SECONDS=120
LEARNING_RATE=0.15

# ---- Demo agents server ----
DEMO_AGENTS_PORT=4000
